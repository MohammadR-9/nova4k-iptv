<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" 
        xmlns:tizen="http://tizen.org/ns/tizen" 
        id="http://yourdomain/TizenIPTVPro" 
        version="1.0.0" 
        viewmodes="maximized">
    <tizen:application id="gR9u2p1L0a.TizenIPTVPro" 
                       package="gR9u2p1L0a" 
                       type="web" 
                       required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>NOVA 4K ULTRA</name>
    <tizen:profile name="tv"/>
    
    <!-- Permissions and Privileges -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/drm.playready"/>

    <!-- Disable CORS and allow streaming from all IPTV sources -->
    <access origin="*" subdomains="true"/>

    <tizen:setting screen-orientation="landscape" 
                   context-menu="enable" 
                   background-support="disable" 
                   encryption="disable" 
                   install-location="auto"/>
</widget>
