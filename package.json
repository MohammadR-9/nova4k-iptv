{
  "name": "tizen-iptv-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package:tizen": "powershell -ExecutionPolicy Bypass -File ./scripts/package-tizen.ps1",
    "package:webos": "powershell -ExecutionPolicy Bypass -File ./scripts/package-webos.ps1",
    "package:android": "powershell -ExecutionPolicy Bypass -File ./scripts/package-android.ps1",
    "package:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/package-windows.ps1",
    "package:all": "powershell -ExecutionPolicy Bypass -File ./scripts/package-all.ps1",
    "start:windows": "npx electron electron/main.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.475.0",
    "mpegts.js": "^1.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shaka-player": "^5.2.9",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
